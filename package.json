{
  "name": "starlight-image-zoom-monorepo",
  "version": "0.9.0",
  "license": "MIT",
  "description": "Starlight plugin adding zoom capabilities to your documentation images.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "scripts": {
    "lint": "astro check --noSync && pnpm -r lint",
    "format": "prettier -w --cache --ignore-unknown .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@hideoo/eslint-config": "^5.2.0",
    "@hideoo/prettier-config": "^2.0.2",
    "@hideoo/tsconfig": "^2.0.4",
    "astro": "^7.2.10",
    "eslint": "^10.10.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "private": true,
  "sideEffects": false,
  "keywords": [
    "starlight",
    "image",
    "zoom",
    "documentation",
    "image-zoom"
  ],
  "homepage": "https://github.com/HiDeoo/starlight-image-zoom",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/starlight-image-zoom.git"
  },
  "bugs": "https://github.com/HiDeoo/starlight-image-zoom/issues"
}
